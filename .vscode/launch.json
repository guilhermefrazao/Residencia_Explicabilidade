{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "subProcess": false,
            "justMyCode": true
        },
        {
        "name": "plot_netorks_weights",
        "type": "debugpy",
        "request": "launch",
        "module": "visualization.plot_netorks_weights",
        "cwd": "${workspaceFolder}",
        "args": ["--classes", "violin", "--ig_batch_size", "32"],
        "justMyCode": true,
        "subProcess": false
        },
        {
        "name": "Training",
        "type": "debugpy",
        "request": "launch",
        "module": "train",
        "cwd": "${workspaceFolder}",
        "args": ["--config", "config/cartpole_dqn.yml"],
        "justMyCode": true,
        "subProcess": false
        },
        {
        "name": "Evaluating",
        "type": "debugpy",
        "request": "launch",
        "module": "evaluation",
        "cwd": "${workspaceFolder}",
        "args": ["--config", "config/cartpole_dqn.yml"],
        "justMyCode": true,
        "subProcess": false
        }
    ]
}